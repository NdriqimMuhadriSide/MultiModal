# Repo-wide ignores. Backend- and frontend-specific rules live in
# backend/.gitignore and frontend/.gitignore, next to what they apply to.

# macOS
.DS_Store

# Claude Code local permissions — machine-specific paths, not project config.
.claude/settings.local.json

# Next.js build output. Also covered by frontend/.gitignore's `/.next/`;
# stated here too so the rule is visible from the repo root.
frontend/.next/
frontend/out/
