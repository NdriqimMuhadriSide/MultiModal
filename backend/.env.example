# --- App ---
APP_NAME=Multimodal AI Assistant
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- CORS ---
# Comma-separated list of allowed origins (use * only for local dev)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- OpenAI (kept for later - vision features, or once billing is set up) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o

# --- Groq (active provider for /chat and /vision - free tier, no billing required) ---
# Get a key at https://console.groq.com -> API Keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# How the provider client handles a request that goes wrong. Retries are
# the SDK's own (429, 408, 409, 5xx, dropped connections - never a 400 or a
# 401), with exponential backoff. The timeouts are deliberately shorter
# than the SDK's 600s default: these calls run in FastAPI's threadpool, so
# a hung connection holds a worker for as long as the timeout allows.
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=60
# Longer, because transcription's duration scales with the size of the
# upload rather than the length of an answer.
TRANSCRIPTION_TIMEOUT_SECONDS=300

# --- Vector DB / RAG (wired up in a later task) ---
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=documents

# --- Embeddings (local, free, no API key required) ---
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# --- Conversation memory (local SQLite, no extra infra required) ---
CONVERSATION_DB_PATH=./data/conversations.sqlite3
CONVERSATION_HISTORY_LIMIT=10

# --- File uploads ---
MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIR=./data/uploads

# --- Document registry (Phase 4A document ingestion) ---
DOCUMENT_REGISTRY_DB_PATH=./data/documents.sqlite3

# --- PDF parsing (Phase 4A document ingestion) ---
# Read each page as a character grid to recover reading order, tables, and
# running headers/footers (rag/layout.py). Set to false for pypdf's plain
# content-stream order.
PDF_LAYOUT_MODE=true

# --- OCR fallback for scanned PDFs (rag/ocr.py) ---
# Runs only on pages that came back with (almost) no text. Needs the Tesseract
# binary: `brew install tesseract` (macOS) or `apt-get install tesseract-ocr`.
# Without it, scanned PDFs are recorded as FAILED with a reason saying so.
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_DPI=300
OCR_MIN_TEXT_CHARS=32
OCR_MAX_PAGES=50

# --- Chunking (Phase 4A document ingestion) ---
# Sized in TOKENS (measured with the embedding model's own tokenizer), not
# characters — the model has a hard 256-token limit and crossing it silently
# truncates. Renamed from CHUNK_SIZE / CHUNK_OVERLAP so a stale character-based
# value isn't reinterpreted as a token count.
CHUNK_SIZE_TOKENS=256
CHUNK_OVERLAP_TOKENS=48
# Prefix each chunk with the heading path it came from ("[2. Methods > 2.1
# Field Sampling]") so the embedded text carries that context — see
# rag/structure.py.
CHUNK_SECTION_HEADERS=true

# --- Chunking strategy (see rag/chunking/__init__.py) ---
# recursive | semantic | sentence_window | parent_document | propositional
# `recursive` is the default: the only one with no runtime dependency on a
# model. The others trade cost and index size for sharper matching.
CHUNKING_STRATEGY=recursive
SEMANTIC_BREAKPOINT_PERCENTILE=95   # semantic: cut at the top N% of distances
SENTENCE_WINDOW_SIZE=3              # sentence_window: neighbours each side
PARENT_CHILD_TOKENS=64              # parent_document: size of embedded children

# --- Contextual retrieval (Anthropic's technique) ---
# Prepends an LLM-written line of context to each chunk before embedding.
# Off by default: one LLM call per chunk at ingestion, and needs GROQ_API_KEY.
# Composes with any CHUNKING_STRATEGY above.
CONTEXTUAL_RETRIEVAL=false
CONTEXTUAL_RESERVED_TOKENS=48

# --- Retrieval ---
# Strategies that point many chunks at one passage need extra candidates so
# that collapsing duplicates still leaves top_k distinct results.
RETRIEVAL_OVERFETCH=4

# dense | keyword | hybrid — see rag/retriever.py.
# `hybrid` runs both halves and fuses their rankings. Embeddings match meaning
# but lose rare literal tokens ("ERR-4021", a surname, a regulation number);
# BM25 matches those exactly but misses paraphrase. Neither costs an API key:
# the keyword half is an in-memory inverted index over what is already in
# Chroma. Set to `dense` for the pre-hybrid behaviour, byte for byte.
RETRIEVAL_MODE=hybrid

# How much each half counts for when the rankings are fused. Raise the keyword
# weight for identifier-heavy technical corpora; raise the dense weight for
# prose where questions rarely reuse the document's own words. 0 disables a half.
HYBRID_DENSE_WEIGHT=1.0
HYBRID_KEYWORD_WEIGHT=1.0

# Reciprocal rank fusion's smoothing constant (rag/fusion.py). 60 is the
# published default: high enough that agreement between the two halves
# outweighs either one's first place.
RRF_K=60

# BM25's term-frequency saturation and length normalisation — Lucene's values.
# Not worth changing without a labelled evaluation set to change them against.
BM25_K1=1.2
BM25_B=0.75

# --- Reranking (rag/reranker.py) ---
# A second pass over the ~20 candidates retrieval produced, scoring each one
# against the question with a cross-encoder that reads both together — which
# the embedding model cannot do, since chunk vectors are computed at ingestion
# before any question exists.
#
# On by default: local and free (no API key), ~80MB downloaded on first use,
# ~15ms per query on top of retrieval. It also makes the fusion weights above
# stop mattering — the cross-encoder redoes the ordering itself, so it only
# needs retrieval to get the right chunk into the shortlist at all.
RERANK_ENABLED=true
RERANK_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
# Drop candidates scoring below this, in (0, 1). 0.0 reorders without dropping,
# which is the safe default: the model is far better at "which of these is
# best" than at "is any of these good enough".
RERANK_MIN_SCORE=0.0

# --- Multi-query retrieval (rag/query_expansion.py) ---
# Ask an LLM for several phrasings of the question, retrieve for each, fuse all
# the rankings. Helps when the document words an answer differently from the
# way the user asked — the original question is always retrieved for too, so a
# rewrite that drops an identifier can't take the right chunk away.
#
# OFF by default, and unlike hybrid/reranking this is not just caution: on the
# project's own 24-question eval it changed nothing once reranking was on, and
# it puts a ~350ms LLM round-trip on the critical path of every question plus
# free-tier rate limit. Worth turning on for a large corpus where Recall@5 is
# short of 100% — measure before believing it helps.
MULTI_QUERY_ENABLED=false
MULTI_QUERY_COUNT=3

# --- Audio understanding (Phase 5) ---
GROQ_WHISPER_MODEL=whisper-large-v3
MAX_AUDIO_SIZE_MB=25

# --- Real-time streaming (Phase 7) ---
MAX_STREAM_FRAME_SIZE_MB=5
STREAM_SAMPLING_STRATEGY=interval
STREAM_SAMPLING_INTERVAL_SECONDS=2.0
STREAM_SAMPLING_FRAME_COUNT=10
STREAM_CONTEXT_WINDOW_SIZE=10
STREAM_SESSION_TTL_SECONDS=300

# --- Corrective RAG (rag/grading.py) ---
# Grade what retrieval produced before answering from it: answer, retry with
# rephrased queries, or refuse. The only thing in the pipeline that can decline
# to answer — every other setting makes retrieval better at finding something,
# this one notices when what it found isn't worth answering from.
#
# Needs RERANK_ENABLED. An LLM is optional (it powers the retry only; grading
# and refusal need none).
#
# OFF by default because it is a real trade: on the project's 34-question eval
# it took correct refusals from 10% to 70% and cost 12.5% false refusals on
# answerable questions. Worth it if users ask things your corpus doesn't cover;
# not worth it if nearly every question has an answer.
CORRECTIVE_RAG_ENABLED=false
CORRECTIVE_ACCEPT_SCORE=0.5
CORRECTIVE_REJECT_SCORE=0.001

# --- Agentic RAG (rag/contextualizer.py, agents/assistant_agent.py) ---
# Rewrite a follow-up question into a standalone one BEFORE retrieving, using
# the conversation so far. Retrieval has no memory: "how far ahead do I have to
# request it?" reaches the index as six words, and the turn that said what "it"
# was never gets there. Passing history to the LLM at answer time — which the
# chat path already does — cannot fix this: by then the chunks are chosen.
#
# ON by default despite costing an LLM call: it only runs on turns that have a
# conversation behind them (the first question of any conversation skips it),
# and it measured strictly better on follow-ups with zero damage to single-turn
# questions.
QUERY_CONTEXTUALIZATION_ENABLED=true

# --- Supervisor agent (agents/supervisor_agent.py) ---
# How many steps the supervisor itself may take: decide, delegate, write up.
SUPERVISOR_MAX_STEPS=6
# Steps for the WHOLE tree — supervisor plus every specialist it calls —
# drawn from one shared pool. This, not the per-agent ceilings, is what
# bounds a delegating run: without it a 6-step supervisor free to call a
# 6-step specialist each step has a worst case of 36 LLM calls.
SUPERVISOR_TREE_BUDGET=14
# Review the supervisor's draft against what its specialists reported before
# it reaches the user, sending it back once if a claim isn't supported. Only
# runs when a specialist was actually consulted, so a directly-answered
# question costs nothing extra.
SUPERVISOR_CRITIC_ENABLED=true

# --- A2A / Agent2Agent (a2a/) ---
# Expose the research agent to OTHER agents over the A2A protocol:
#   GET  /.well-known/agent-card.json   discovery
#   POST /a2a/v1                        JSON-RPC (message/send, tasks/get)
#
# Off removes both routes from the app entirely. Leave it off, or put
# authentication in front of it, anywhere the port is reachable: nothing in
# phase 1 checks credentials, so any caller who can reach this endpoint can
# spend this deployment's LLM budget and read answers drawn from its corpus.
A2A_ENABLED=true

# The A2A revision a2a/types.py was written against.
A2A_PROTOCOL_VERSION=0.3.0

# How this agent identifies itself in its card. The version is the agent's
# own, not the protocol's — move it when the prompts or tools change, since
# callers use it to notice that a peer's behaviour shifted under them.
A2A_AGENT_NAME=Document Research Agent
A2A_AGENT_VERSION=1.0.0

# The base URL other agents use to reach this one, used to build the card's
# `url` field. The setting most likely to be wrong in a real deployment: it
# has to be what a THIRD PARTY can resolve, not what this process binds to.
# Behind a proxy or in a container those differ, and a card advertising the
# internal address sends every future caller somewhere that doesn't exist.
A2A_PUBLIC_BASE_URL=http://localhost:8000
# The JSON-RPC path. Not fixed by the spec (unlike the well-known card path),
# and read by both the route and the card so the two can't drift.
A2A_RPC_PATH=/a2a/v1

# Optional attribution. The provider block is left out of the card entirely
# when the organization is blank.
A2A_PROVIDER_ORGANIZATION=
A2A_PROVIDER_URL=

# How many finished tasks stay readable by `tasks/get`. In-memory and
# per-process — see a2a/task_store.py on why that's a development-only
# answer, and what a multi-worker deployment needs instead.
A2A_MAX_STORED_TASKS=256
