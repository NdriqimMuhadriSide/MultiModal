__pycache__/
*.pyc
.venv/
venv/
# `.env*` rather than `.env`, because the exact-match rule only covered the
# one filename. A `.env.bak`, `.env.local` or `.env.production` - the files
# people actually create while debugging a deployment - were left untracked
# but NOT ignored, which is the dangerous combination: invisible in the diff,
# one `git add -A` away from publishing a live API key.
.env*
!.env.example
data/uploads/*
!data/uploads/.gitkeep
data/chroma/*
!data/chroma/.gitkeep
data/conversations.sqlite3
data/documents.sqlite3
data/embedding_cache.sqlite3
# Images and audio, kept so a turn's attachment_ref still resolves after the
# response. User content, and content-addressed, so there is nothing here
# worth committing.
data/attachments/*
!data/attachments/.gitkeep
.pytest_cache/
*.egg-info/
.DS_Store
