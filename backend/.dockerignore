# What must not go into the image. Two kinds of thing: build artefacts that
# would be wrong on a different platform, and runtime state that belongs on
# the volume rather than baked into the image.

# The local virtualenv is macOS-built and 1.4GB. Copying it in would both
# bloat the image and shadow the Linux packages installed by the Dockerfile.
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Runtime state. `data/` is the volume mount point - shipping a copy of the
# local Chroma index, conversation history and stored attachments would mean
# every deploy resets production to whatever was on this laptop.
data/

# Secrets. Environment variables are set on the platform, never in the image:
# anything COPYed in is readable by anyone who can pull it.
.env
.env.*
!.env.example

# Measurement output - regenerated by `python -m evals.runner`, and not
# something the running service reads.
evals/reports/

.DS_Store
